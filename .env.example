# Supabase: panel del proyecto → API (URL, clave pública y clave secreta).
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
SUPABASE_SECRET_KEY=sb_secret_example

# PowerShell: $env:PLAYWRIGHT_BROWSERS_PATH = (Join-Path $env:TEMP 'decisionos-playwright')

CRON_SECRET=replace-with-a-long-random-secret

# Activa el asesor con fake para pruebas. El driver anthropic genera coste real.
# AI_DRIVER=fake
AI_MODEL=claude-opus-5-5
AI_FAKE_MODE=ok
# ANTHROPIC_API_KEY=

# Descomenta MAIL_DRIVER para enviar alertas al Mailpit local.
# MAIL_DRIVER=mailpit
# Resend envía correo real.
# MAIL_DRIVER=resend
# RESEND_API_KEY=
MAIL_FROM="DecisionOS <alertas@decisionos.local>"
APP_URL=http://127.0.0.1:3000
MAILPIT_URL=http://127.0.0.1:54324
